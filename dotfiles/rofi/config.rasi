configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "app";
    display-run: "run";
    display-window: "win";
    font: "Iosevka Nerd Font 11";
    drun-display-format: "{name}";
    window-format: "{w} · {c} · {t}";
}

/* Palette + layout. current-theme.rasi is writable and swapped by `theme <name>`. */
@theme "current-theme.rasi"
