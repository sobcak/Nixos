input {
      keyboard {
        xkb {
            layout "cz"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
focus-follows-mouse max-scroll-amount="25%"
    warp-mouse-to-focus
  }

prefer-no-csd






output "eDP-1" {
    mode "1920x1200@60.00"
    scale 1.25
    position x=0 y=0
}





output "Philips Consumer Electronics Company 32M2C5501 AU02430002133" {
    mode "2560x1440@144.001"
    position x=0 y=-1440
    focus-at-startup
}

output "HP Inc. HP E24i G4 CNK3020FB7" {
    transform "270"
    position x=2560 y=-1440
    layout {
        default-column-width { proportion 1.0; }
    }
}

output "HDMI-A-1" {
    mode "2560x1440@144.001"
    scale 1.25
    position x=0 y=-1200
}


layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    // Native absolute void background. swaybg is terminated.
    background-color "#000000"

    focus-ring {
        width 2
        active-color "#44444444"
        inactive-color "#00000000"
    }
    border { off; }
}

// Brutalist 90-degree corners
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match app-id="startup-kitty"
    default-column-width { proportion 0.6; }
}

// Opacity Rules
window-rule {
    match is-active=true
    opacity 1.0
}
window-rule {
    match is-active=false
    opacity 1.0
}

// Daemons (see ~/.config/niri/dependencies.nix) — start audio + bar via systemd
spawn-at-startup "sh" "-c" "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP NIRI_SOCKET && systemctl --user start pipewire.socket pipewire-pulse.socket wireplumber waybar"
spawn-at-startup "polkit-gnome-authentication-agent-1"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "sunsetr"
spawn-at-startup "swaync"
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "kitty" "--class" "startup-kitty" "-e" "fish" "-c" "fastfetch; exec fish"

// __CURSOR_SIZE__ is substituted per-host in home.nix (desktop vs thinkpad DPI).
// Theme must be installed (home.pointerCursor); missing theme → huge niri fallback.
cursor {
    xcursor-theme "Adwaita"
    xcursor-size __CURSOR_SIZE__
}

environment {
    QT_QPA_PLATFORMTHEME "qt5ct:qt6ct"
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    MOZ_ENABLE_WAYLAND "1"
    GDK_BACKEND "wayland,x11"
    SDL_VIDEODRIVER "wayland"
    CLUTTER_BACKEND "wayland"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XDG_SESSION_DESKTOP "niri"
    DISPLAY ":0"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

binds {
    // --- System Binds ---
    Mod+section { show-hotkey-overlay; }
    Mod+S { switch-preset-column-width; }
    Mod+Return { spawn "kitty"; }
    Mod+W { close-window; }
    Mod+M { quit; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+R { spawn "rofi" "-show" "drun"; }
    Mod+Space { spawn "rofi" "-show" "drun"; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { maximize-column; }
    Mod+L { spawn "hyprlock"; }
    Mod+B { spawn "zen"; }
    Mod+N { spawn "swaync-client" "-t" "-sw"; } // Fixed conflict
    Mod+C { center-visible-columns; }
    Mod+O { open-overview; }
    //Mod+Shift+C { spawn-sh "cliphist list | rofi -dmenu | cliphist decode | wl-copy"; }
    Mod+Shift+M { spawn "sh" "-c" "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }
    

    // --- Layout Actions ---
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }
    Mod+Shift+C { center-column; } // Replaces dwindle pseudo
    Mod+J { toggle-column-tabbed-display; } // Replaces dwindle togglesplit
    



// --- Focus & Movement (Arrows) ---
    Mod+Left { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down { move-window-down-or-to-workspace-down; }



    // --- Window Movement (HJKL mapping as requested) ---
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }

    // --- Resize Windows (Ctrl + Arrows) ---
    Mod+Ctrl+Left { set-column-width "-20"; }
    Mod+Ctrl+Right { set-column-width "+20"; }
    Mod+Ctrl+Up { set-window-height "-20"; }
    Mod+Ctrl+Down { set-window-height "+20"; }

    // --- Resize Windows (Ctrl + HJKL) ---
    Mod+Ctrl+H { set-column-width "-20"; }
    Mod+Ctrl+L { set-column-width "+20"; }
    Mod+Ctrl+K { set-window-height "-20"; }
    Mod+Ctrl+J { set-window-height "+20"; }

    // --- Workspaces (Czech Layout) ---
    Mod+Plus   { focus-workspace 1; }
    Mod+Ecaron { focus-workspace 2; }
    Mod+Scaron { focus-workspace 3; }
    Mod+Ccaron { focus-workspace 4; }
    Mod+Rcaron { focus-workspace 5; }
    Mod+Zcaron { focus-workspace 6; }
    Mod+Yacute { focus-workspace 7; }
    Mod+Aacute { focus-workspace 8; }
    Mod+Iacute { focus-workspace 9; }
    Mod+Eacute { focus-workspace 10; }

    // --- Move to Workspaces (Czech Layout) ---
    Mod+Shift+Plus   { move-column-to-workspace 1; }
    Mod+Shift+Ecaron { move-column-to-workspace 2; }
    Mod+Shift+Scaron { move-column-to-workspace 3; }
    Mod+Shift+Ccaron { move-column-to-workspace 4; }
    Mod+Shift+Rcaron { move-column-to-workspace 5; }
    Mod+Shift+Zcaron { move-column-to-workspace 6; }
    Mod+Shift+Yacute { move-column-to-workspace 7; }
    Mod+Shift+Aacute { move-column-to-workspace 8; }
    Mod+Shift+Iacute { move-column-to-workspace 9; }
    Mod+Shift+Eacute { move-column-to-workspace 10; }

    // --- Niri Scratchpad Simulation ---
    

    // --- Navigation Fixes ---
    Mod+Shift+Tab       { move-column-left; }
    Mod+Shift+Semicolon { move-column-right; }
    // --- Mouse Wheel Workspaces ---
    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp { focus-workspace-up; }

    // --- Media & System Keys ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }

    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "10%-"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "10%+"; }

    XF86Sleep    { spawn "hyprlock"; }
    XF86PowerOff { spawn "hyprlock"; }

    // --- Screenshots ---
    Print { spawn-sh "hyprshot -m region -o ~/Pictures/Screenshots"; }
  }
